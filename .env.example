# Sard's own Supabase project (see sard/backend/). Copy to .env and fill in.
VITE_SARD_SUPABASE_URL=
VITE_SARD_SUPABASE_ANON_KEY=

# Where the muṣḥaf plates are served from (the R2 bucket). Always set it for a
# production build — without it the build points at /app/mushafs and 404s.
VITE_MUSHAF_BASE_URL=https://mushaf.tajweedoo.com

# Only for `npm run mushaf:upload`.
R2_BUCKET=
