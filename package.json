{
  "name": "sard-quran",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "pretest": "npm run sard:assets",
    "sard:assets": "node scripts/copy-sard-assets.mjs",
    "dev:sard": "npm run sard:assets && vite --config vite.sard.config.ts",
    "build:sard": "npm run sard:assets && vite build --config vite.sard.config.ts",
    "preview:sard": "vite preview --config vite.sard.config.ts",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "mushaf:fetch": "node scripts/fetch-mushaf.mjs",
    "mushaf:validate": "node scripts/validate-mushaf.mjs",
    "mushaf:index": "node scripts/index-mushaf.mjs",
    "mushaf:index-pages": "node scripts/index-mushaf-from-pages.mjs",
    "mushaf:from-pdf": "node scripts/pdf-to-mushaf.mjs",
    "deploy:build": "node scripts/deploy-sard.mjs",
    "mushaf:upload": "node scripts/upload-mushafs.mjs",
    "matn:build": "node scripts/build-matn.mjs",
    "phonemiser:verify": "node --experimental-strip-types scripts/verify-phonemiser.mjs",
    "android:build": "node scripts/build-native.mjs android",
    "android:icons": "node scripts/android-adaptive-icons.mjs",
    "android:open": "npx cap open android",
    "android:run": "npx cap run android",
    "ios:build": "node scripts/build-native.mjs ios",
    "ios:open": "npx cap open ios",
    "ios:run": "npx cap run ios",
    "dev": "npm run dev:sard",
    "build": "npm run build:sard",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "eval:asr": "esbuild scripts/eval-asr.ts --bundle --platform=node --format=esm --packages=external --alias:@=./src --outfile=.cache/eval-asr.mjs --log-level=warning && node .cache/eval-asr.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^7.6.8",
    "@capacitor/app": "^7.1.2",
    "@capacitor/core": "^7.6.8",
    "@capacitor/filesystem": "^7.1.8",
    "@capacitor/ios": "^7.6.8",
    "@capacitor/local-notifications": "^7.0.7",
    "@capacitor/share": "^7.0.4",
    "@capacitor/splash-screen": "^7.0.5",
    "@capacitor/status-bar": "^7.0.6",
    "@supabase/supabase-js": "^2.109.0",
    "html2canvas": "^1.4.1",
    "lucide-react": "^1.7.0",
    "onnxruntime-web": "1.23.2",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sonner": "^1.7.4",
    "tailwindcss-animate": "^1.0.7",
    "vite-plugin-pwa": "^1.3.0"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1114.0",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^7.6.8",
    "@eslint/js": "^9.32.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.0.0",
    "@types/node": "^22.16.5",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react-swc": "^3.11.0",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.32.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^15.15.0",
    "jsdom": "^20.0.3",
    "pdfjs-dist": "^5.5.207",
    "postcss": "^8.5.6",
    "supabase": "^2.114.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0",
    "vite": "^5.4.19",
    "vitest": "^3.2.4"
  }
}
