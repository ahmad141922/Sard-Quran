{"id": "jazariyya", "editionAr": "نصّ موقع surahquran.com", "editionEn": "Text from surahquran.com", "totalAbyat": 109, "abwab": [{"n": 1, "titleAr": "المقدمة", "titleEn": "Introduction", "from": 1, "to": 8}, {"n": 2, "titleAr": "باب مَخَارِجِ الحُرُوفِ", "titleEn": "The points of articulation", "from": 9, "to": 19}, {"n": 3, "titleAr": "باب صِفَاتِ الحُرُوفِ", "titleEn": "The qualities of the letters", "from": 20, "to": 26}, {"n": 4, "titleAr": "باب التَّجْوِيدِ", "titleEn": "Tajwīd", "from": 27, "to": 33}, {"n": 5, "titleAr": "باب التَّرْقِيقَاتِ", "titleEn": "Thinning", "from": 34, "to": 40}, {"n": 6, "titleAr": "باب الرَّاءَاتِ", "titleEn": "The rāʾ", "from": 41, "to": 43}, {"n": 7, "titleAr": "باب فِي اللَّامَاتِ", "titleEn": "The lām", "from": 44, "to": 44}, {"n": 8, "titleAr": "باب أحكام متفرقة", "titleEn": "Miscellaneous rulings", "from": 45, "to": 51}, {"n": 9, "titleAr": "باب الضاد والظَّاء", "titleEn": "Ḍād and ẓāʾ", "from": 52, "to": 59}, {"n": 10, "titleAr": "باب التَّحْذِيرَاتِ", "titleEn": "Cautions", "from": 60, "to": 61}, {"n": 11, "titleAr": "باب النون والميم المشددتين والميم الساكنة", "titleEn": "The doubled nūn and mīm, and the silent mīm", "from": 62, "to": 64}, {"n": 12, "titleAr": "باب أحكام النُّونِ السَّاكِنَةِ وَالتَّنْوِينِ", "titleEn": "The silent nūn and tanwīn", "from": 65, "to": 68}, {"n": 13, "titleAr": "باب المَدّ", "titleEn": "Prolongation", "from": 69, "to": 72}, {"n": 14, "titleAr": "باب معرفة الوقف والابتداء", "titleEn": "Stopping and starting", "from": 73, "to": 78}, {"n": 15, "titleAr": "باب المَقْطُوعِ وَالمَوْصُولِ", "titleEn": "Separated and joined spellings", "from": 79, "to": 93}, {"n": 16, "titleAr": "باب التَّاءَاتِ", "titleEn": "The tāʾ", "from": 94, "to": 100}, {"n": 17, "titleAr": "باب هَمز الوَصْلِ", "titleEn": "The joining hamza", "from": 101, "to": 103}, {"n": 18, "titleAr": "باب الوَقْفِ عَلَى أَوَاخِرِ الكَلِمِ", "titleEn": "Stopping on word endings", "from": 104, "to": 105}, {"n": 19, "titleAr": "خاتمة", "titleEn": "Conclusion", "from": 106, "to": 109}], "abyat": [{"n": 1, "sadr": "يَقُولُ رَاجِي عَفْوِ رَبٍّ سَامِعِ", "ajz": "مُحَمَّدُ ابْنُ الجَزَرِيِّ الشَّافِعِي", "bab": 1}, {"n": 2, "sadr": "الحَمْدُ لِلَّهِ وَصَلَّى اللَّهُ", "ajz": "عَلَى نَبِيِّهِ وَمُصْطَفَاهُ", "bab": 1}, {"n": 3, "sadr": "مُحَمَّدٍ وَآلِهِ وَصَحْبِهِ", "ajz": "وَمُقْرِئِ القُرْآنِ مَعْ مُحِبِّهِ", "bab": 1}, {"n": 4, "sadr": "وَبَعْدُ: إِنَّ هَذِهِ «مُقَدِّمَهْ", "ajz": "فِيمَا عَلَى قَارِئِهِ أَنْ يَعْلَمَهْ»", "bab": 1}, {"n": 5, "sadr": "إِذْ وَاجِبٌ عَلَيْهِمُ مُحَتَّمُ", "ajz": "قَبْلَ الشُّرُوعِ أَوَّلاً أَنْ يَعْلَمُوا", "bab": 1}, {"n": 6, "sadr": "مَخَارِجَ الحُرُوفِ وَالصِّفَاتِ", "ajz": "لِيَلْفِظُوا بِأَفْصَحِ اللُّغَاتِ", "bab": 1}, {"n": 7, "sadr": "مُحَرِّرِي التَّجْوِيدِ وَالمَوَاقِفِ", "ajz": "وَمَا الَّذِي رُسِمَ فِي المَصَاحِفِ", "bab": 1}, {"n": 8, "sadr": "مِنْ كُلِّ مَقْطُوعٍ وَمَوْصُولٍ بِهَا", "ajz": "وَتَاءِ أُنْثَى لَمْ تَكُنْ تُكْتَبْ بِـ «هَا»", "bab": 1}, {"n": 9, "sadr": "مَخَارِجُ الحُرُوفِ سَبْعَةَ عَشَرْ", "ajz": "عَلَى الَّذِي يَخْتَارُهُ مَنِ اخْتَبَرْ", "bab": 2}, {"n": 10, "sadr": "فَأَلِفُ الجَوْفِ وَأُخْتَاهَا وَهِي", "ajz": "حُرُوفُ مَدٍّ لِلْهَوَاءِ تَنْتَهِي", "bab": 2}, {"n": 11, "sadr": "ثُمَّ لِأَقْصَى الحَلْقِ: هَمْزٌ هَاءُ", "ajz": "ثُمَّ لِوَسْطِهِ: فَعَيْنٌ حَاءُ", "bab": 2}, {"n": 12, "sadr": "أَدْنَاهُ: غَيْنٌ خَاؤُهَا، وَالقَافُ", "ajz": "أَقْصَى اللِّسَانِ فَوْقُ، ثُمَّ الكَافُ", "bab": 2}, {"n": 13, "sadr": "أَسْفَلُ، وَالوَسْطُ: فَجِيمُ الشِّينُ يَا", "ajz": "وَالضَّادُ: مِنْ حَافَتِهِ إِذْ وَلِيَا", "bab": 2}, {"n": 14, "sadr": "لَاضْرَاسَ مِنْ أَيْسَرَ أَوْ يُمْنَاهَا", "ajz": "وَاللَّامُ: أَدْنَاهَا لِمُنْتَهَاهَا", "bab": 2}, {"n": 15, "sadr": "وَالنُّونُ: مِنْ طَرَفِهِ تَحْتُ اجْعَلُوا", "ajz": "وَالرَّا: يُدَانِيهِ لِظَهْرٍ أَدْخَلُ", "bab": 2}, {"n": 16, "sadr": "وَالطَّاءُ وَالدَّالُ وَتَا: مِنْهُ وَمِنْ", "ajz": "عُلْيَا الثَّنَايَا، وَالصَّفِيرُ: مُسْتَكِنْ", "bab": 2}, {"n": 17, "sadr": "مِنْهُ وَمِنْ فَوْقِ الثَّنَايَا السُّفْلَى", "ajz": "وَالظَّاءُ وَالذَّالُ وَثَا: لِلْعُلْيَا", "bab": 2}, {"n": 18, "sadr": "مِنْ طَرَفَيْهِمَا، وَمِنْ بَطْنِ الشَّفَهْ", "ajz": "فَالْفَا مَعَ اطْرَافِ الثَّنَايَا المُشْرِفَهْ", "bab": 2}, {"n": 19, "sadr": "لِلشَّفَتَيْنِ: الوَاوُ بَاءٌ مِيمُ", "ajz": "وَغُنَّةٌ: مَخْرَجُهَا الخَيْشُومُ", "bab": 2}, {"n": 20, "sadr": "صِفَاتُهَا: جَهْرٌ، وَرِخْوٌ، مُسْتَفِلْ", "ajz": "مُنْفَتِحٌ، مُصْمَتَةٌ، وَالضِّدَّ: قُلْ", "bab": 3}, {"n": 21, "sadr": "مَهْمُوسُهَا: «فَحَثَّهُ شَخْصٌ سَكَتْ»", "ajz": "شَدِيدُهَا: لَفْظُ «أَجِدْ قَطٍ بَكَتْ»", "bab": 3}, {"n": 22, "sadr": "وَبَيْنَ رِخْوٍ وَالشَّدِيدِ: «لِنْ عُمَرْ»", "ajz": "وَسَبْعُ عُلْوٍ: «خُصَّ ضَغْطٍ قِظْ» حَصَرْ", "bab": 3}, {"n": 23, "sadr": "وَصَادُ ضَادٌ طَاءُ ظَاءٌ: مُطْبَقَهْ", "ajz": "وَ «فَرَّ مِنْ لُبِّ»: الحُرُوفُ المُذْلَقَهْ", "bab": 3}, {"n": 24, "sadr": "صَفِيرُهَا: صَادٌ وَزَايٌ سِينُ", "ajz": "قَلْقَلَةٌ: «قُطْبُ جَدٍ»، وَاللِّينُ", "bab": 3}, {"n": 25, "sadr": "وَاوٌ وَيَاءٌ سُكِّنَا وَانْفَتَحَا", "ajz": "قَبْلَهُمَا، وَالِانْحِرَافُ صُحِّحَا", "bab": 3}, {"n": 26, "sadr": "فِي اللَّامِ وَالرَّا، وَبِتَكْرِيرٍ جُعِلْ", "ajz": "وَلِلتَّفَشِّي: الشِّينُ، ضَاداً: اسْتَطِلْ", "bab": 3}, {"n": 27, "sadr": "وَالأَخْذُ بِالتَّجْوِيدِ حَتْمٌ لَازِمُ", "ajz": "مَنْ لَمْ يُصَحِّحِ القُرَانَ آثِمُ", "bab": 4}, {"n": 28, "sadr": "لِأَنَّهُ بِهِ الإِلَهُ أَنْزَلَا", "ajz": "وَهَكَذَا مِنْهُ إِلَيْنَا وَصَلَا", "bab": 4}, {"n": 29, "sadr": "وَهُوَ أَيْضاً حِلْيَةُ التِّلَاوَةِ", "ajz": "وَزِينَةُ الأَدَاءِ وَالقِرَاءَةِ", "bab": 4}, {"n": 30, "sadr": "وَهُوَ: «إِعْطَاءُ الحُرُوفِ حَقَّهَا", "ajz": "مِنْ صِفَةٍ لَهَا وَمُسْتَحَقَّهَا", "bab": 4}, {"n": 31, "sadr": "وَرَدُّ كُلِّ وَاحِدٍ لِأَصْلِهِ", "ajz": "وَاللَّفْظُ فِي نَظِيرِهِ كَمِثْلِهِ", "bab": 4}, {"n": 32, "sadr": "مُكَمَّلاً مِنْ غَيْرِ مَا تَكَلُّفِ", "ajz": "بِاللُّطْفِ فِي النُّطْقِ بِلَا تَعَسُّفِ»", "bab": 4}, {"n": 33, "sadr": "وَلَيْسَ بَيْنَهُ وَبَيْنَ تَرْكِهِ", "ajz": "إِلَّا رِيَاضَةُ امْرِئٍ بِفَكِّهِ", "bab": 4}, {"n": 34, "sadr": "فَرَقِّقَنْ مُسْتَفِلاً مِنْ أَحْرُفِ", "ajz": "وَحَاذِرَنْ تَفْخِيمَ لَفْظِ الأَلِفِ", "bab": 5}, {"n": 35, "sadr": "وَهَمْزَ: «أَلْحَمْدُ، أَعُوذُ، إِهْدِنَا", "ajz": "أَللَّهِ» ثُمَّ لَامَ: «لِلَّهِ، لَنَا", "bab": 5}, {"n": 36, "sadr": "وَلْيَتَلَطَّفْ، وَعَلَى اللَّهِ، وَلَا الضْ»", "ajz": "وَالمِيمَ مِنْ «مَخْمَصَةٍ» وَمِنْ «مَرَضْ»", "bab": 5}, {"n": 37, "sadr": "وَبَاءَ: «بَرْقٍ، بَاطِلٍ، بِهِمْ، بِذِي»", "ajz": "وَاحْرِصْ عَلَى الشِّدَّةِ وَالجَهْرِ الَّذِي", "bab": 5}, {"n": 38, "sadr": "فِيهَا وَفِي الجِيمِ؛ كَـ «حُبِّ، الصَّبْرِ", "ajz": "رَبْوَةٍ، اجْتُثَّتْ، وَحَجِّ، الفَجْرِ»", "bab": 5}, {"n": 39, "sadr": "وَبَيِّنَنْ مُقَلْقَلاً إِنْ سَكَنَا", "ajz": "وَإِنْ يَكُنْ فِي الوَقْفِ كَانَ أَبْيَنَا", "bab": 5}, {"n": 40, "sadr": "وَحَاءَ: «حَصْحَصَ، أَحَطْتُ، الحَقُّ»", "ajz": "وَسِينَ: «مُسْتَقِيمِ، يَسْطُو، يَسْقُو»", "bab": 5}, {"n": 41, "sadr": "وَرَقِّقِ الرَّاءَ إِذَا مَا كُسِرَتْ", "ajz": "كَذَاكَ بَعْدَ الكَسْرِ حَيْثُ سَكَنَتْ", "bab": 6}, {"n": 42, "sadr": "إِنْ لَمْ تَكُنْ مِنْ قَبْلِ حَرْفِ اسْتِعْلَا", "ajz": "أَوْ كَانَتِ الكَسْرَةُ لَيْسَتْ أَصْلَا", "bab": 6}, {"n": 43, "sadr": "وَالخُلْفُ فِي «فِرْقٍ»؛ لِكَسْرٍ يُوجَدُ", "ajz": "وَأَخْفِ تَكْرِيراً إِذَا تُشَدَّدُ", "bab": 6}, {"n": 44, "sadr": "وَفَخِّمِ اللَّامَ مِنِ اسْمِ «اللَّهِ»", "ajz": "عَنْ فَتْحٍ اَوْ ضَمٍّ كَـ «عَبْدُ اللَّهِ»", "bab": 7}, {"n": 45, "sadr": "وَحَرْفَ الِاسْتِعْلَاءِ فَخِّمْ، وَاخْصُصَا", "ajz": "لِاطْبَاقَ أَقْوَى؛ نَحْوُ: «قَالَ» وَ «العَصَا»", "bab": 8}, {"n": 46, "sadr": "وَبَيِّنِ الإِطْبَاقَ مِنْ «أَحَطْتُ» مَعْ", "ajz": "«بَسَطْتَ»، وَالخُلْفُ بِـ «نَخْلُقْكُمْ» وَقَعْ", "bab": 8}, {"n": 47, "sadr": "وَاحْرِصْ عَلَى السُّكُونِ فِي «جَعَلْنَا»", "ajz": "«أَنْعَمْتَ» وَ «المَغْضُوبِ» مَعْ «ضَلَلْنَا»", "bab": 8}, {"n": 48, "sadr": "وَخَلِّصِ انْفِتَاحَ «مَحْذُوراً، عَسَى»", "ajz": "خَوْفَ اشْتِبَاهِهِ بِـ «مَحْظُوراً، عَصَى»", "bab": 8}, {"n": 49, "sadr": "وَرَاعِ شِدَّةً بِكَافٍ وَبِتَا", "ajz": "كَـ «شِرْكِكُمْ» وَ «تَتَوَفَّى، فِتْنَتَا»", "bab": 8}, {"n": 50, "sadr": "وَأَوَّلَيْ مِثْلٍ وَجِنْسٍ إِنْ سَكَنْ", "ajz": "أَدْغِمْ؛ كَـ «قُلْ رَبِّ» وَ «بَلْ لَا»، وَأَبِنْ", "bab": 8}, {"n": 51, "sadr": "«فِي يَوْمِ» مَعْ «قَالُوا وَهُمْ» وَ «قُلْ نَعَمْ»", "ajz": "«سَبِّحْهُ، لَا تُزِغْ قُلُوبَ، فَالْتَقَمْ»", "bab": 8}, {"n": 52, "sadr": "وَالضَّادَ بِاسْتِطَالَةٍ وَمَخْرَجِ", "ajz": "مَيِّزْ مِنَ الظَّاءِ، وَكُلُّهَا تَجِي", "bab": 9}, {"n": 53, "sadr": "فِي «الظَّعْنِ، ظِلُّ، الظُّهْرِ، عُظْمُ، الحِفْظِ", "ajz": "أَيْقِظْ، وَأَنْظِرْ، عَظْمَ، ظَهْرِ، اللَّفْظِ", "bab": 9}, {"n": 54, "sadr": "ظَاهِرْ، لَظَى، شُوَاظُ، كَظْمٍ، ظَلَمَا", "ajz": "أُغْلُظْ، ظَلَامَ، ظُفْرٍ، انْتَظِرْ، ظَمَا", "bab": 9}, {"n": 55, "sadr": "أَظْفَرَ، ظَنّاً كَيْفَ جَا، وَعِظْ» سِوَى", "ajz": "«عِضِينَ»، «ظَلَّ»: النَّحْلِ، زُخْرُفٍ؛ سَوَا", "bab": 9}, {"n": 56, "sadr": "وَ «ظَلْتَ، ظَلْتُمْ» وَبِرُومٍ: «ظَلُّوا»", "ajz": "كَالحِجْرِ: «ظَلَّتْ» شُعَرَا: «نَظَلُّ»", "bab": 9}, {"n": 57, "sadr": "«يَظْلَلْنَ، مَحْظُوراً» مَعَ «المُحْتَظِرِ»", "ajz": "وَ «كُنْتَ فَظّاً» وَجَمِيعَ «النَّظَرِ»", "bab": 9}, {"n": 58, "sadr": "إِلَّا بِـ «وَيْلٌ» «هَلْ» وَأُولَى «نَاضِرَهْ»", "ajz": "وَ «الغَيْظُ» لَا الرَّعْدُ وَهُودٌ؛ قَاصِرَهْ", "bab": 9}, {"n": 59, "sadr": "وَ «الحَظُّ» لَا «الحَضُّ عَلَى الطَّعَامِ»", "ajz": "وَفِي «ظَنِينٍ»: الخِلَافُ سَامِي", "bab": 9}, {"n": 60, "sadr": "وَإِنْ تَلَاقَيَا: البَيَانُ لَازِمُ", "ajz": "«أَنْقَضَ ظَهْرَكَ، يَعَضُّ الظَّالِمُ»", "bab": 10}, {"n": 61, "sadr": "وَ «اضْطُرَّ» مَعْ «وَعَظْتَ» مَعْ «أَفَضْتُمُ»", "ajz": "وَصَفِّ «هَا»: «جِبَاهُهُمْ، عَلَيْهِمُ»", "bab": 10}, {"n": 62, "sadr": "وأَظْهِرِ الغُنَّةَ مِنْ: نُونٍ، وَمِنْ", "ajz": "مِيمٍ؛ إِذَا مَا شُدِّدَا، وَأَخْفِيَنْ", "bab": 11}, {"n": 63, "sadr": "المِيمَ إِنْ تَسْكُنْ بِغُنَّةٍ لَدَى", "ajz": "بَاءٍ عَلَى المُخْتَارِ مِنْ أَهْلِ الأَدَا", "bab": 11}, {"n": 64, "sadr": "وَأَظْهِرَنْهَا عِنْدَ: بَاقِي الأَحْرُفِ", "ajz": "وَاحْذَرْ لَدَى وَاوٍ وَفَا: أَنْ تَخْتَفِي", "bab": 11}, {"n": 65, "sadr": "وَحُكْمُ تَنْوِينٍ وَنُونٍ يُلْفَى", "ajz": "إِظْهَارٌ، ادْغَامٌ، وَقَلْبٌ، إِخْفَا", "bab": 12}, {"n": 66, "sadr": "فَعِنْدَ حَرْفِ الحَلْقِ: أَظْهِرْ، وَادَّغِمْ", "ajz": "فِي اللَّامِ وَالرَّا لَا بِغُنَّةٍ لَزِمْ", "bab": 12}, {"n": 67, "sadr": "وَأَدْغِمَنْ بِغُنَّةٍ فِي: «يُومِنُ»", "ajz": "إِلَّا بِكِلْمَةٍ؛ كَـ «دُنْيَا، عَنْوَنُوا»", "bab": 12}, {"n": 68, "sadr": "وَالقَلْبُ عِنْدَ: البَا بِغُنَّةٍ، كَذَا", "ajz": "لِاخْفَا لَدَى: بَاقِي الحُرُوفِ؛ أُخِذَا", "bab": 12}, {"n": 69, "sadr": "وَالمَدُّ: لَازِمٌ، وَوَاجِبٌ أَتَى", "ajz": "وَجَائِزٌ، وَهْوَ وَقَصْرٌ ثَبَتَا", "bab": 13}, {"n": 70, "sadr": "فَلَازِمٌ: إِنْ جَاءَ بَعْدَ حَرْفِ مَدْ", "ajz": "سَاكِنُ حَالَيْنِ، وَبِالطُّولِ يُمَدْ", "bab": 13}, {"n": 71, "sadr": "وَوَاجِبٌ: إِنْ جَاءَ قَبْلَ هَمْزَةِ", "ajz": "مُتَّصِلاً؛ إِنْ جُمِعَا بِكِلْمَةِ", "bab": 13}, {"n": 72, "sadr": "وَجَائِزٌ: إِذَا أَتَى مُنْفَصِلَا", "ajz": "أَوْ عَرَضَ السُّكُونُ وَقْفاً مُسْجَلَا", "bab": 13}, {"n": 73, "sadr": "وَبَعْدَ تَجْوِيدِكَ لِلْحُرُوفِ", "ajz": "لَا بُدَّ مِنْ مَعْرِفَةِ الوُقُوفِ", "bab": 14}, {"n": 74, "sadr": "وَالِابْتِدَاءِ، وَهْيَ تُقْسَمُ إِذَنْ", "ajz": "ثَلَاثَةً: تَامٌ، وَكَافٍ، وَحَسَنْ", "bab": 14}, {"n": 75, "sadr": "وَهْيَ لِمَا تَمَّ؛ فَإِنْ لَمْ يُوجَدِ", "ajz": "تَعَلُّقٌ، أَوْ كَانَ مَعْنىً؛ فَابْتَدِي", "bab": 14}, {"n": 76, "sadr": "فَالتَّامُ، فَالكَافِي، وَلَفْظاً: فَامْنَعَنْ", "ajz": "إِلَّا رُؤُوسَ الآيِ جَوِّزْ، فَالحَسَنْ", "bab": 14}, {"n": 77, "sadr": "وَغَيْرُ مَا تَمَّ قَبِيحٌ، وَلَهُ", "ajz": "الوَقْفُ مُضْطَرّاً؛ وَيَبْدَا قَبْلَهُ", "bab": 14}, {"n": 78, "sadr": "وَلَيْسَ فِي القُرْآنِ مِنْ وَقْفٍ وَجَبْ", "ajz": "وَلَا حَرَامٌ؛ غَيْرُ مَا لَهُ سَبَبْ", "bab": 14}, {"n": 79, "sadr": "وَاعْرِفْ لِمَقْطُوعٍ وَمَوْصُولٍ وَ «تَا»", "ajz": "فِي المُصْحَفِ الإِمَامِ فِيمَا قَدْ أَتَى", "bab": 15}, {"n": 80, "sadr": "فَاقْطَعْ بِعَشْرِ كَلِمَاتٍ: «أَنْ لَا»", "ajz": "مَعْ «مَلْجَأً» وَ «لَا إِلَهَ إِلَّا»", "bab": 15}, {"n": 81, "sadr": "وَ «تَعْبُدُوا» يَاسِينَ، ثَانِي هُودَ «لَا", "ajz": "يُشْرِكْنَ، تُشْرِكْ، يَدْخُلَنْ، تَعْلُوا عَلَى", "bab": 15}, {"n": 82, "sadr": "أَنْ لَا يَقُولُوا، لَا أَقُولَ»، «إِنْ مَا»", "ajz": "بِالرَّعْدِ، وَالمَفْتُوحَ صِلْ، وَ «عَنْ مَا", "bab": 15}, {"n": 83, "sadr": "نُهُوا» اقْطَعُوا؛ «مِنْ مَا» بِرُومٍ وَالنِّسَا", "ajz": "خُلْفُ المُنَافِقِينَ، «أَمْ مَنْ»: «أَسَّسَا»", "bab": 15}, {"n": 84, "sadr": "فُصِّلَتِ، النِّسَا، وَذِبْحٍ، «حَيْثُ مَا»", "ajz": "وَ «أَنْ لَمِ» المَفْتُوحَ، كَسْرَ «إِنَّ مَا»", "bab": 15}, {"n": 85, "sadr": "لَانْعَامَ، وَالمَفْتُوحَ «يَدْعُونَ» مَعَا", "ajz": "وَخُلْفُ الَانْفَالِ، وَنَحْلٍ وَقَعَا", "bab": 15}, {"n": 86, "sadr": "وَ «كُلِّ مَا سَأَلْتُمُوهُ»، وَاخْتُلِفْ", "ajz": "«رُدُّوا» كَذَا «قُلْ بِئْسَمَا»، وَالوَصْلَ صِفْ", "bab": 15}, {"n": 87, "sadr": "«خَلَفْتُمُونِي» وَ «اشْتَرَوْا»، «فِي مَا» اقْطَعَا", "ajz": "«أُوحِي، أَفَضْتُمُ، اشْتَهَتْ، يَبْلُو» مَعَا", "bab": 15}, {"n": 88, "sadr": "ثَانِي «فَعَلْنَ» وَقَعَتْ، رُومٌ، كِلَا", "ajz": "تَنْزِيلُ، ظُلَّةٍ، وَغَيْرَهَا: صِلَا", "bab": 15}, {"n": 89, "sadr": "«فَأَيْنَمَا» كَالنَّحْلِ: صِلْ، وَمُخْتَلِفْ", "ajz": "فِي: الشُّعَرَا، الأَحْزَابِ، وَالنِّسَا؛ وُصِفْ", "bab": 15}, {"n": 90, "sadr": "وَصِلْ: «فَإِلَّمْ» هُودَ «أَلَّنْ نَجْعَلَا»", "ajz": "«نَجْمَعَ» «كَيْلَا تَحْزَنُوا، تَأْسَوْا عَلَى", "bab": 15}, {"n": 91, "sadr": "حَجٌّ، عَلَيْكَ حَرَجٌ»، وَقَطْعُهُمْ", "ajz": "«عَنْ مَنْ يَشَاءُ، مَنْ تَوَلَّى» «يَوْمَ هُمْ»", "bab": 15}, {"n": 92, "sadr": "«وَمَالِ هَذَا، وَالَّذِينَ، هَؤُلَا»", "ajz": "«تَحِينَ» فِي الإِمَامِ صِلْ؛ وَوُهِّلَا", "bab": 15}, {"n": 93, "sadr": "وَ «وَزَنُوهُمُ، وَكَالُوهُمْ»: صِلِ", "ajz": "كَذَا مِنَ «الْ» وَ «هَا» وَ «يَا»؛ لَا تَفْصِلِ", "bab": 15}, {"n": 94, "sadr": "وَ «رَحْمَتُ»: الزُّخْرُفِ بِالتَّا زَبَرَهْ", "ajz": "لَاعْرَافِ، رُومٍ، هُودَ، كَافَ، البَقَرَهْ", "bab": 16}, {"n": 95, "sadr": "«نِعْمَتُـ» ـهَا: ثَلَاثُ نَحْلٍ، إِبْرَهَمْ", "ajz": "مَعاً أَخِيرَاتٌ، عُقُودُ الثَّانِ «هَمْ»", "bab": 16}, {"n": 96, "sadr": "لُقْمَانُ، ثُمَّ فَاطِرٌ، كَالطُّورِ", "ajz": "عِمْرَانَ، «لَعْنَتٌ»: بِهَا، وَالنُّورِ", "bab": 16}, {"n": 97, "sadr": "وَ «امْرَأَتٌ»: يُوسُفَ، عِمْرَانَ، القَصَصْ", "ajz": "تَحْرِيمُ، «مَعْصِيَتْ»: بِقَدْ سَمِعْ يُخَصْ", "bab": 16}, {"n": 98, "sadr": "«شَجَرَتُ»: الدُّخَانِ، «سُنَّتْ»: فَاطِرِ", "ajz": "كُلّاً، وَالَانْفَالِ، وَأُخْرَى غَافِرِ", "bab": 16}, {"n": 99, "sadr": "«قُرَّتُ عَيْنٍ»، «جَنَّتٌ»: فِي وَقَعَتْ", "ajz": "«فِطْرَتْ، بَقِيَّتْ، وَابْنَتٌ»، وَ «كَلِمَتْ»", "bab": 16}, {"n": 100, "sadr": "أَوْسَطَ الَاعْرَافِ، وَكُلُّ مَا اخْتُلِفْ", "ajz": "جَمْعاً وَفَرْداً فِيهِ: بِالتَّاءِ عُرِفْ", "bab": 16}, {"n": 101, "sadr": "وَابْدَأْ بِهَمْزِ الوَصْلِ مِنْ فِعْلٍ بِضَمْ", "ajz": "إِنْ كَانَ ثَالِثٌ مِنَ الفِعْلِ يُضَمْ", "bab": 17}, {"n": 102, "sadr": "وَاكْسِرْهُ حَالَ الكَسْرِ وَالفَتْحِ، وَفِي", "ajz": "لَاسْمَاءِ - غَيْرِ اللَّامِ - كَسْرُهَا وَفِيّْ", "bab": 17}, {"n": 103, "sadr": "ابْنٍ، مَعَ ابْنَةِ، امْرِئٍ، وَاثْنَيْنِ", "ajz": "وَامْرَأَةٍ، وَاسْمٍ، مَعَ اثْنَتَيْنِ", "bab": 17}, {"n": 104, "sadr": "وَحَاذِرِ الوَقْفَ بِكُلِّ الحَرَكَهْ", "ajz": "إِلَّا إِذَا رُمْتَ فَبَعْضُ الحَرَكَهْ", "bab": 18}, {"n": 105, "sadr": "إِلَّا بِفَتْحٍ أَوْ بِنَصْبٍ، وَأَشِمْ", "ajz": "إِشَارَةً بِالضَّمِّ: فِي رَفْعٍ وَضَمْ", "bab": 18}, {"n": 106, "sadr": "وَقَدْ تَقَضَّى نَظْمِيَ «المُقَدِّمَهْ»", "ajz": "مِنِّي لِقَارِئِ القُرَانِ تَقْدِمَهْ", "bab": 19}, {"n": 107, "sadr": "أَبْيَاتُهَا قَافٌ وَزَاىٌ فِي الْعَدَدْ", "ajz": "مَنْ يُحْسِنِ التَّجْوِيدَ يَظْفَرْ بِالرَّشَدْ", "bab": 19}, {"n": 108, "sadr": "وَالحَمْدُ لِلَّهِ لَهَا خِتَامُ", "ajz": "ثُمَّ الصَّلَاةُ بَعْدُ وَالسَّلَامُ", "bab": 19}, {"n": 109, "sadr": "عَـلَى النَّبِـىِّ المُـصْطَـفى وَآلِـهِ", "ajz": "وَصَــحْـبِـهِ وتـابـعِ منوالــهِ", "bab": 19}]}