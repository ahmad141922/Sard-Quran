"ajz":"قِراءةً أوْ شأنُهُ التقليدُ","bab":23},{"n":160,"sadr":"أوْ كانَ مِنْ حُكْمِ الوُقوفِ يُدْرَى","ajz":"أوْ مِنْ مَسائلِ اختلافِ القُرَّا","bab":23},{"n":161,"sadr":"اعْلَمْ أَخِي بأنَّ للقرءانِ","ajz":"ثلاثَةً تأتي مِنَ الأَرْكانِ","bab":24},{"n":162,"sadr":"تَوافُقَ النَّحوِ وخَطَّ المصحَفِ","ajz":"وصِحَّةَ الإسنادِ فيما تَعرِفِ","bab":24},{"n":163,"sadr":"وفَخِّمِ استِعلا بِتَرْتِيبٍ يَفِيْ","ajz":"طِبْ ضَيْفَ صِدْقٍ ظَلَّ قُلْ غَيرَ خَفِيْ)","bab":25},{"n":164,"sadr":"أَشَدُّها المَفتوحُ بَعدَهُ أَلفْ","ajz":"ودُونَهُ المفتوحُ مِنْ غَيْرِ أَلفْ","bab":25},{"n":165,"sadr":"مَضمُومُها وساكنٌ عنْ كَسْرِ","ajz":"مكسورُها فخمسةٌ بالحَصْرِ","bab":25},{"n":166,"sadr":"وساكنٌ عنْ فتحةٍ كفتحةِ","ajz":"وساكنٌ عنْ ضَمَّةٍ كَضمَّةِ","bab":25},{"n":167,"sadr":"كُلَّ حُروفِ الاستفالِ رَقِّقِ","ajz":"والأَلِفَ اتبِعْها لحرفٍ سابقِ","bab":26},{"n":168,"sadr":"واللهَ فَخِّمْ بعدَ فتحةٍ وضَمْ","ajz":"لا بعدَ كسْرٍ نحوُ عبدُ اللهِ عَمْ","bab":26},{"n":169,"sadr":"ورقِّقِ الرَّا حالَ الاِنكسارِ","ajz":"وحالَ إِسكانٍ عنِ انكِسارِ","bab":27},{"n":170,"sadr":"إِنْ كانَ أَصليًّا وموصولاً بِها","ajz":"وليسَ عُلْوٌ بَعْدُ في كِلْمتِها","bab":27},{"n":171,"sadr":"وفِرْقٍ الخِلافُ فيهِ مشُتَهَرْ","ajz":"لأنَّ الاِسْتعلاءَ بَعدَها انكَسَرْ","bab":27},{"n":172,"sadr":"ورَقِّقنْ وقفًا بُعيْدَ الكَسْرِ","ajz":"أو يا سَكَنْ أو ساكنٍ عن كَسْرِ","bab":27},{"n":173,"sadr":"والخُلْفُ في القِطْرِ وفي مِصْرَ أَتَى","ajz":"واخْتِيرَ ما في وَصْلِ كُلٍّ ثَبتَا","bab":27},{"n":174,"sadr":"وَبعدَ فَتحٍ وانضِمامٍ فَخِّما","ajz":"أوْ بعدَ ساكنٍ أَتَى بَعدَهُما","bab":27},{"n":175,"sadr":"ورَجَّحوا التفخيمَ في وَقْفٍ كُسِرْ","ajz":"عنْ غَيْرِ كَسْرٍ عَكْسَ يَسْرِ ونُذُرْ","bab":27},{"n":176,"sadr":"وإِنْ تَقِفْ بالرَّوْمِ راعِ الوَصْلا","ajz":"ولا تُنوِّنْ مَعَ رَوْمٍ أَصْلا","bab":27},{"n":177,"sadr":"وأَخْفِ تَكْريرًا بِراءٍ شُدِّدَتْ","ajz":"وَصْلاً وَوَقْفًا وكَذا إِنْ سَكَنَتْ","bab":27},{"n":178,"sadr":"إيَّاكَ أَنْ تُفَخِّمَ المُسَتفِلا","ajz":"إنْ كانَ الاِستعلا بهِ متَّصِلا","bab":28},{"n":179,