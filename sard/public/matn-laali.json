َانِسَانِ حَيْثُ ائْتَلَفَا","ajz":"فِي مَخْرَجٍ وَفِي الصِّفَاتِ اخْتَلَفَا","bab":12},{"n":59,"sadr":"وَمُتَقَارِبَانِ حَيْثُ فِيهِمَا","ajz":"تَقَارُبٌ أَوْ كَانَ فِي أَيِّهِمَا","bab":12},{"n":60,"sadr":"وَمُتَبَاعِدَانِ حَيْثُ مَخْرَجَا","ajz":"تَبَاعَدا وَالخُلْفُ فِي الصِّفَاتِ جَا","bab":12},{"n":61,"sadr":"وَحَيْثُمَا تَحَرَّكَ الحَرْفَانِ فِي","ajz":"كَلٍّ فَسَمِّ بِالكَبِيرِ وَاقْتَف","bab":12},{"n":62,"sadr":"وَسَمِّ بِالصَّغِيرِ حَيْثُمَا سَكَنْ","ajz":"أَوَّلُهَا وَمُطْلَقٌ فِي العَكْسِ عَنْ","bab":12},{"n":63,"sadr":"أَوَّلَ مِثْلَيِ الصَّغِيرِ دُونَ مَدّ","ajz":"أَدْغِمْ وَلَكِنْ سَكْتُ (مَالِيَهْ) أَسَدّ","bab":13},{"n":64,"sadr":"وَالجِنْسُ مِنْهُ النُّونُ فِي المِيمِ ادُّغِمْ","ajz":"وَهَكَذا ارْكَبْ مَعَ يَلْهَثْ قَدْ عُلِمْ","bab":13},{"n":65,"sadr":"كَإِذْ بِظَا وَالدَّالُ أَوْ طَا أُدْغِمَا","ajz":"فِي التَا مَعَ الإِطْبَاقِ وَهْيَ فِيهِمَا","bab":13},{"n":66,"sadr":"وَالقُرْبُ مِنْهُ النُّونُ فِي حُرُوفِ (رَلْ)","ajz":"وَ (وَيْ) كَذَاكَ اللامُ فِي رَاءٍ دَخَلْ","bab":13},{"n":67,"sadr":"وَقَافُ نَخْلُقكُّمْ بِكَافِهِ ادُّغِمْ","ajz":"مَعْ وَصْفِ عُلْوٍ وَالأصَحُّ أَنْ يَتِمّ","bab":13},{"n":68,"sadr":"وَالنُّونَ فِي مَالَكَ لا تَامَنَّا","ajz":"أَشمِمْهُ مُدْغِمًا أوَ اخْفِيَنَّا","bab":13},{"n":69,"sadr":"ذَا نَاقِصٌ إِنْ يَبْقَ وَصْفُ المُدْغَمِ","ajz":"وَكَامِلٌ إِنْ يُمْحَ ذَا فَلْيُعْلَم","bab":14},{"n":70,"sadr":"حُرُوفَ الاسْتِفَالِ حَتْمًا رَقِّقِ","ajz":"وَالعُلْوَ فَخِّمْ سِيَّمَا فِي المُطْبَق","bab":15},{"n":71,"sadr":"أَعْلاهُ فِي كَطَائِفٌ فَصَلَّى","ajz":"فَقُرْبَةٌ فَلا تُزِغْ فَظِلاَّ","bab":15},{"n":72,"sadr":"وَاللامُ فِي اسْمِ اللهِ حَيْثُمَا أَتَتْ","ajz":"مِنْ بَعْدِ فَتْحَةٍ وَضَمٍّ غُلِّظَتْ","bab":15},{"n":73,"sadr":"وَالرَّاءُ رُقِّقَتْ إِذَا مَا سَكَنَتْ","ajz":"مِنْ بَعْدِ وَصْلِ كَسْرَةٍ تَأَصَّلَتْ","bab":15},{"n":74,"sadr":"وَلَمْ تَكُنْ مِنْ قَبْلِ فَتْحِ اسْتِعْلا","ajz":"مُتَّصِلٍ وَرِقُّ (فِرْقٍ) أعْلَى","bab":15},{"n":75,"sadr":"وَرُقِّقَتْ مَكْسُورَةً وَفُخِّمَتْ","ajz":"فِي الوَقْفِ وَهْوَ رَاجِحٌ إذْ كُس