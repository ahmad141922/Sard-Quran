:19},{"n":94,"sadr":"وَرُمْ لَدَى جَرٍّ وَكَسْرٍ وَكِلاَ","ajz":"هَذَيْنِ فِي نَصْبٍ وَفَتْحٍ حُظِلا","bab":19},{"n":95,"sadr":"وَعِنْدَ هَا أُنثَى وَمِيمِ الجَمْعِ أَوْ","ajz":"عَارِضِ تَحْرِيكٍ كِلَيْهِمَا نَفَوْا","bab":19},{"n":96,"sadr":"وَالخُلْفُ فِي هَاءِ الضَّمِيرِ وَالأتَمّ","ajz":"دَعْ بَعْدَ يَا وَالوَاوِ أَوْ كَسْرٍ وَضَمّ","bab":19},{"n":97,"sadr":"إِنْ جَاءَ مَدٌ قَبْلُ أَوْ لِينٌ جَرَى","ajz":"فَأَشْبِعًا أَوْ وَسِّطًا أَوِ اقْصُرَا","bab":20},{"n":98,"sadr":"وَزِدْ بِرَفْعٍ مَعَهَا الإشمَامَا","ajz":"وَفِيهِ كَالمَجْرُورِ زِدْ مُرَامَا","bab":20},{"n":99,"sadr":"ثَلاثَةٌ نَصْبًا وَأَرْبَعٌ بِجَرّ","ajz":"وَسَبْعَةٌ فِي عَارِضِ الرَّفْعِ تَقَرّ","bab":20},{"n":100,"sadr":"وَإِنْ خَلا مِنْ ذَيْنِ فَالسُّكُونُ قَرّ","ajz":"وَالرَّفْعَ أَشمِمْ ثُمَّ رُمْهُ مَعَ جَرّ","bab":20},{"n":101,"sadr":"فَوَاحِدٌ فِي النَّصْبِ وَاثْنَانِ لَدَى","ajz":"جَرٍّ وَفِي الرَّفْعِ ثَلاثَةٌ بَدَا","bab":20},{"n":102,"sadr":"وَسَوِّ رَوْمَ أَوْ ثَلاثَ عَارِضِ","ajz":"بِآخَرٍ إِنْ تُشْمِمَ اوْ تُمَحِّض","bab":21},{"n":103,"sadr":"وَالنَّصْبَ ثَلِّثْ إِنْ تَرُمْ فِيمَا عَدَا","ajz":"فَسِتَّةٌ فِي النَّصْبِ مَعْ جَرٍّ بَدَا","bab":21},{"n":104,"sadr":"وَجَاءَ فِي رَفْعٍ وَجَرٍ سَبْعَةُ","ajz":"وَالنَّصْبِ مَعْ رَفْعٍ كَكُلٍّ تِسْعَةُ","bab":21},{"n":105,"sadr":"عَارِضُ مَدِّ وَقْفَ لِينٍ إِنْ تَلا","ajz":"فَسَوِّ أَوْ زِدْ فِي الأخِيرِ مَا عَلا","bab":22},{"n":106,"sadr":"وَسَوِّ حَالَ العَكْسِ أَوْ زِدْ مَا نَزَلْ","ajz":"بِالمَحْضِ أَوْ إشْمَامِ مَا بِالرَّفْعِ حَلّ","bab":22},{"n":107,"sadr":"وَفِيهِ مَعْ ذِي الجَرِّ زِدَ رَوْمًا كَإِذْ","ajz":"جُرَّا وَزِدْ ثَلاثَ نَصْبٍ حَينَئِذْ","bab":22},{"n":108,"sadr":"فَسِتَّةٌ إِذْ نُصِبَا وَسَبْعٌ اذْ","ajz":"جُرَّا وَتِسْعٌ فِيهِ مَعْ نَصْبٍ أُخِذْ","bab":22},{"n":109,"sadr":"وَعِنْدَ رَفْعِ ذَيْنِ أَوْ فِيمَا يُجَرّ","ajz":"مَعْ صَاحِبِ الرَّفْعِ ثَلاثَةَ عَشَرْ","bab":22},{"n":110,"sadr":"وَفِيهِ مَعْ ذِي النَّصْبِ خَمْسَةَ عَشَرْ","ajz":"وَجَازَ فِي الكُلِّ ثَمَانٍ مَعْ عَشَرْ","bab":22},{"n":111,"sadr":"سَكِّنْهُ إِنْ تَقِفْ وَأَشْمِمْ رَافِعًا","ajz":"وَرُمْهُ مَعْ جَرٍّ بِمَدٍّ مُشْبِعًا","bab":23},{"n":112,"sadr":"قَدْ مَدَّ ذَا فَصْلٍ وَمَا يَتَّصِلُ","ajz":"خَمْسًا وَأَرْبَعًا وَهَذَا أَعْدَلُ","bab":24},{"n":113,"sadr":"وَزَادَ فِي كَـ (المَاءِ) سِتًّا إِنْ يَقِفْ","ajz":"وَالرَّفْعَ أَشْمِمْ مُطْلَقًا كَمَا عُرِفْ","bab":24},{"n":114,"sadr":"وَرُمْهُ مَعْ جَرٍّ بِمَا بِهِ وُصِلْ","ajz":"فَفِي انْفِرَادِهِ ثَلاثَةٌ تَحِلّ","bab":24},{"n":115,"sadr":"فَتِلْكَ فِي نَصْبٍ وَخَمْسَةٌ بِجَرّ","ajz":"وَأَوْجُهُ الرَّفْعِ ثَمَانٍ تُعْتَبَرْ","bab":24},{"n":116,"sadr":"وَفِي اجْتِمَاعِهِ بِذِي انْفِصَالِ","ajz":"أَوْ جَمْعِهِ مَعْ وَصْلِ ذِي اتِّصَال","bab":24},{"n":117,"sadr":"أَرْبَعَةٌ نَصْبًا وَسِتَّةٌ بِجَرّ","ajz":"وَعَشْرَةٌ فِي حَالةِ الرَّفْعِ تَقَرّ","bab":24},{"n":118,"sadr":"وَمُدَّ عَارِضَ السُّكُونِ إِنْ يُمَدّ","ajz":"سِتًّا فَفِي نَصْبِهِمَا سَبْعٌ تُعَدّ","bab":24},{"n":119,"sadr":"وَإِنْ يُجَرَّا فَالوُجُوهُ تِسْعَةُ","ajz":"وَحَالَ نَصْبِهِ بِجَرٍّ عَشْرَةُ","bab":24},{"n":120,"sadr":"وَحِينَ عَكْسِ ذَا ثَلاثةَ عَشَرْ","ajz":"وَعِنْدَ رَفْعِ ذَيْنِ سِتَّةَ عَشَرْ","bab":24},{"n":121,"sadr":"كَعِنْدَ ذِي رَفْعٍ بِجَرٍّ وَاسْتَقِرّ","ajz":"فِي نَصْبِهِ بِالرَّفْعِ سَبْعَةَ عَشَرْ","bab":24},{"n":122,"sadr":"وَحِينَمَا يُرْفَعُ مَعْ نَصْبٍ فَقُلْ","ajz":"عِشْرُونَ مِثْلُ رَفْعِهِ فِي جَمْعِ كُلّ","bab":24},{"n":123,"sadr":"وَحَيْثُمَا يُنْصَبُ فَالكُلُّ اجْتَمَعْ","ajz":"فَوَاحِدٌ مِنْ بَعْدِ عِشْرِينَ وَقَعْ","bab":24},{"n":124,"sadr":"وَوَارِدٌ إِثْبَاتُ يَا فِي الأيْدِي","ajz":"بَعْدَ أُوليِ وَالحَذْفُ فِي ذَا الأيْد","bab":25},{"n":125,"sadr":"وَوَقْفُ مُعْجِزِي مُحِلِّي حَاضِري","ajz":"آتِي المُقِيمِي مُهْلِكِي بِاليَا دُرِي","bab":25},{"n":126,"sadr":"وَالحَذْفُ قَبْلَ سَاكِنٍ فِي اليَا رَسَا","ajz":"وَقْفًا كَوَصْلٍ عِنْدَ نُنجِ يُونُسَا","bab":25},{"n":127,"sadr":"وَاخْشَوْنِ مَعْ يُؤْتِ النِّسَا وَالوَادِ","ajz":"وَوَادِ وَالجَوارِ مَعْ لَهَاد","bab":25},{"n":128,"sadr":"وَهَادِ رُومٍ صَالِ تُغْنِ بِالقَمَرْ","ajz":"يُرِدْنِ مَعْ عِبَادِ أوَّلَيْ زُمَرْ","bab":25},{"n":129,"sadr":"وَالوَاوِ فِي وَيَمْحُ ثُمَّ يَدْعُ","ajz":"الاِنسانُ وَالدَّاعِ كَذَا سَنَدْعُ","bab":25},{"n":130,"sadr":"وَصَالِحُ التَّحْريمِ ثُمَّ الألِفِ","ajz":"فِي أيُّهَ الرَّحْمَنِ نُورِ الزُّخْرُف","bab":25},{"n":131,"sadr":"وَفِي سَلاسِلاً وَمَا ءَاتَانِ قِفْ","ajz":"بِالحَذْفِ وَالإِثْبَاتِ فِي اليَا وَالأَلِفْ","bab":25},{"n":132,"sadr":"وَقِفْ بِها فِي لَيَكُونًا نَسْفَعَا","ajz":"إِذًا وَلَكِنَّا وَنَحْوِ رُكَّعَا","bab":25},{"n":133,"sadr":"أَنَا مَعَ الظُّنُونَ وَالرَّسُولا","ajz":"كَانَتْ قَوَارِيرَا مَعَ السَّبِيلا","bab":25},{"n":134,"sadr":"وَحَذْفُهَا وَصْلا وَمُطلَقًا لَدَى","ajz":"ثَمُودَ مَعْ أُخْرَى قَوَارِيرَ بَدَا","bab":25},{"n":135,"sadr":"تُقْطَعُ أَنْ عَنْ كُلِّ لَمْ ولَوْ نَشَا","ajz":"كَانُوا يَشَا وَالخُلْفُ فِي الجِنِّ فَشَا","bab":26},{"n":136,"sadr":"وَقَطْعُ أَنْ لَنْ غَيرَ أَلَّنْ نَجْعَلا","ajz":"نَجْمَعَ وَالخُلْفُ بِتُحْصُوهُ انْجَلَى","bab":26},{"n":137,"sadr":"وَنُونَ أَنْ لا يَدْخُلَنَّهَا افْصِلا","ajz":"يُشْرِكْنَ مَعْ مَلْجَأَ مَعْ تَعْلُوا عَلَى","bab":26},{"n":138,"sadr":"تُشْركْ أَقُولَ مَعْ يَقُولُوا تَعْبُدوا","ajz":"يس وَالأُخْرى بِهُودٍ قَيَّدوا","bab":26},{"n":139,"sadr":"كَذَا بِهَا أَنْ لا إِلَهَ وَاخْتُلِفْ","ajz":"فِي الأَنبِيا وَوَصْلَ إِلا الكُلِّ صِفْ","bab":26},{"n":140,"sadr":"كَنُونِ إِلَّمْ هُودَ وَافْصِلْ إِنْ مَا","ajz":"بِالرَّعْدِ ثُمَّ صِلْ جَمِيعَ أَمَّا","bab":26},{"n":141,"sadr":"وَقُطِعَتْ أَمْ مَنْ بِذِبْحٍ وَالنِّسَا","ajz":"وَفُصِّلَتْ أَيْضًا وَأَمْ مَنْ أَسَّسَا","bab":26},{"n":142,"sadr":"وَأَنَّ مَا يَدْعُونَ الاثْنَيْنِ افْصِلا","ajz":"وَخُلْفُ أَنَّمَا غَنِمْتُمْ حَصَلا","bab":26},{"n":143,"sadr":"مَعْ إنَّمَا عِنْدَ لَدَى النَّحْلِ وَقَعْ","ajz":"وَقَبْلَ تُوعَدُونَ الاَنْعَامَ انقَطَعْ","bab":26},{"n":144,"sadr":"وَصِلْ فَأَيْنَمَا كَنَحْلٍ وَجَرَى","ajz":"خُلْفٌ بِالاَحْزَابِ النِّسَا وَالشُّعَرَا","bab":26},{"n":145,"sadr":"وَقَطْعُ حَيْثُ مَا مَعًا وَيَوْمَ هُمْ","ajz":"عَلَى وَبَارِزُونَ عَكْسُ يَبْنَؤُمّ","bab":26},{"n":146,"sadr":"وَفِي النِّسَا مِنْ مَا بِقَطْعِهِ وُصِ