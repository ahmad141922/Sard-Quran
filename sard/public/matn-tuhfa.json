{"id": "tuhfa", "editionAr": "نصّ موقع surahquran.com", "editionEn": "Text from surahquran.com", "totalAbyat": 61, "abwab": [{"n": 1, "titleAr": "المقدّمة", "titleEn": "Introduction", "from": 1, "to": 5}, {"n": 2, "titleAr": "النون الساكنة والتنوين", "titleEn": "The silent nūn and tanwīn", "from": 6, "to": 16}, {"n": 3, "titleAr": "الميم والنون المشدّدتين", "titleEn": "The doubled mīm and nūn", "from": 17, "to": 17}, {"n": 4, "titleAr": "الميم الساكنة", "titleEn": "The silent mīm", "from": 18, "to": 23}, {"n": 5, "titleAr": "لام «أل» ولام الفعل", "titleEn": "The lām of al- and of the verb", "from": 24, "to": 29}, {"n": 6, "titleAr": "المثلين والمتقاربين والمتجانسين", "titleEn": "Identical, near and homogeneous letters", "from": 30, "to": 34}, {"n": 7, "titleAr": "أقسام المدّ", "titleEn": "Kinds of madd", "from": 35, "to": 41}, {"n": 8, "titleAr": "أحكام المدّ", "titleEn": "Rules of madd", "from": 42, "to": 47}, {"n": 9, "titleAr": "أقسام المدّ اللازم", "titleEn": "Kinds of the obligatory madd", "from": 48, "to": 57}, {"n": 10, "titleAr": "الخاتمة", "titleEn": "Conclusion", "from": 58, "to": 61}], "abyat": [{"n": 1, "sadr": "يَقُولُ رَاجِي رَحمةِ الْغَفُورِ", "ajz": "دَوْماً سُلَيْمَانُ هُوَ الْجَمْزُورِى", "bab": 1}, {"n": 2, "sadr": "الْحَمْدُ لِلَّهِ مُصَلِّياً عَلى", "ajz": "مُحَمَدٍ وآلِهِ وَمَنْ تَلاَ", "bab": 1}, {"n": 3, "sadr": "وَبَعْدُ هذَا النَّظْمُ لِلْمُرِيدِ", "ajz": "في النُونِ والتَّنْوِينِ وَالْمُدُودِ", "bab": 1}, {"n": 4, "sadr": "سَمَّيتُهُ بِتُحفَة الأَطْفَالِ", "ajz": "عَنْ شَيْخِنَا الْمَيْهِىِّ ذِي الْكَمالِ", "bab": 1}, {"n": 5, "sadr": "أَرْجُو بِه أَنْ يَنْفَعَ الطُّلاَّبَا", "ajz": "وَالأَجْرَ وَالْقَبُولَ وَالثَّوَابا", "bab": 1}, {"n": 6, "sadr": "لِلنُّونِ إِنْ تَسْكُنْ وَلِلتَّنْوِينِ", "ajz": "أَرْبَعُ أَحْكَامٍ فَخُذْ تَبْيِينِي", "bab": 2}, {"n": 7, "sadr": "فَالأَوَّلُ الإظْهَارُ قَبْلَ أَحْرُفِ", "ajz": "لِلْحَلْقِ سِتٌ رُتِّبَتْ فَلتَعْرِفِ", "bab": 2}, {"n": 8, "sadr": "هَمْزٌ فَهَاءٌ ثُمَّ عَيْنٌ حَاءُ", "ajz": "مُهْمَلَتَانِ ثُمَّ غَيْنٌ خَاءُ", "bab": 2}, {"n": 9, "sadr": "والثَّانِ إِدْغَامٌ بِستَّةٍ أَتَتْ", "ajz": "فِي يَرْمَلُونَ عِنْدَهُمْ قَدْ ثَبَتَتْ", "bab": 2}, {"n": 10, "sadr": "لَكِنَّهَا قِسْمَانِ قِسْمٌ يُدْغَمَا", "ajz": "فِيهِ بِغُنَّةٍ بِيَنْمُو عُلِمَا", "bab": 2}, {"n": 11, "sadr": "إِلاَّ إِذَا كَانَا بِكِلْمَةٍ فَلاَ", "ajz": "تُدْغِمْ كَدُنْيَا ثُمَّ صِنْوَانٌ تَلاَ", "bab": 2}, {"n": 12, "sadr": "وَالثَّانِ إِدْغَامٌ بِغَيْرِ غُنَّةْ", "ajz": "في اللاَّمِ وَالرَّا ثُمَّ كَرّرَنَّهْ", "bab": 2}, {"n": 13, "sadr": "وَّالثَالثُ الإِقْلاَبُ عِنْدَ الْبَاءِ", "ajz": "مِيماً بِغُنَةٍ مَعَ الإِخْفَاءِ", "bab": 2}, {"n": 14, "sadr": "وَالرَّابِعُ الإِخْفَاءُ عِنْدَ الْفاضِلِ", "ajz": "مِنَ الحُرُوفِ وَاجِبٌ لِلْفَاضِلِ", "bab": 2}, {"n": 15, "sadr": "في خَمْسَةٍ مِنْ بَعْدِ عَشْرٍ رَمْزُهَا", "ajz": "فِي كِلْمِ هذَا البَيْتِ قَدْ ضَمَّنْتُهَا", "bab": 2}, {"n": 16, "sadr": "صِفْ ذَا ثَنَا كَمْ جَادَ شَخْصٌ قَدْ سمَا", "ajz": "دُمْ طَيَّباً زِدْ فِي تُقَىً ضَعْ ظَالِمَا", "bab": 2}, {"n": 17, "sadr": "وَغُنَّ مِيماً ثُمَّ نُوناً شُدِّدَا", "ajz": "وَسَمِّ كُلاً حَرْفَ غُنَّةٍ بَدَا", "bab": 3}, {"n": 18, "sadr": "وَالِميمُ إِنْ تَسْكُنْ تَجِى قَبْلَ الْهِجَا", "ajz": "لاَ أَلِفٍ لَيِّنَةٍ لِذِى الْحِجَا", "bab": 4}, {"n": 19, "sadr": "أَحْكَامُهَا ثَلاَثَةٌ لِمَنْ ضَبَطْ", "ajz": "إِخْفَاءٌ ادْغَامٌ وَإِظْهَارٌ فَقَطْ", "bab": 4}, {"n": 20, "sadr": "فَالأَوَّلُ الإِخْفَاءُ عِنْدَ الْبَاءِ", "ajz": "وَسَمِّهِ الشَّفْوِىَّ لِلْقُرَّاءِ", "bab": 4}, {"n": 21, "sadr": "وَالثَّانِ إِدْغَامٌ بِمِثْلِهَا أَتَى", "ajz": "وَسَمِّ إدغاماً صَغِيراً يَا فَتَى", "bab": 4}, {"n": 22, "sadr": "وَالثَّالِثُ الإِظْهَارُ فِى الْبَقِيَّةْ", "ajz": "مِنْ أَحْرُفٍ وَسَمِّهَا شَفْوِيَّهْ", "bab": 4}, {"n": 23, "sadr": "وَاحْذَرْ لَدَى وَاوٍ وَفَا أَنْ تَخْتَفىِ", "ajz": "لِقُرْبِهَا وَلِاتحادِ فَاعْرِفِ", "bab": 4}, {"n": 24, "sadr": "لِلاَمِ أَلْ حَالاَنِ قَبْلَ الْأَحْرُفِ", "ajz": "أُولاَهُمَا إِظْهَارُهَا فَلْتَعْرِفِ", "bab": 5}, {"n": 25, "sadr": "قَبْلَ ارْبَعٍ مَعْ عَشْرَةٍ خُذْ عِلْمَهُ", "ajz": "مِنْ إِبْغِ حَجَّكَ وَخَفْ عَقِيمَهُ", "bab": 5}, {"n": 26, "sadr": "ثَانِيهِمَا إِدْغَامُهَا فى أَرْبَعِ", "ajz": "وَعَشْرَةٍ أَيْضاً وَرَمْزَهَا فَعِ", "bab": 5}, {"n": 27, "sadr": "طِبْ ثُمَّ صِلْ رَحِماً تَفُزْ ضِفْ ذَا نِعَمْ", "ajz": "دَعْ سُوءَ ظَنٍ زُرْ شَرِيفَاً لِلْكَرَم", "bab": 5}, {"n": 28, "sadr": "وَاللاَّمَ الاُولَى سَمِّهَا قَمْرِيَّهْ", "ajz": "وَاللاَّمَ الاُخْرىَ سَمِّهَا شَمْسِيَّهْ", "bab": 5}, {"n": 29, "sadr": "وأظْهِرَنَّ لاَمَ فِعْلٍ مُطْلَقاً", "ajz": "فى نَحْوِ قُلْ نَعَمْ وَقُلْنَا وَالْتَقَى", "bab": 5}, {"n": 30, "sadr": "إِنْ فِي الصِّفَاتِ وَالمَخَارِجِ اتَّفَقْ", "ajz": "حَرْفَانِ فَالْمِثْلاَنِ فِيهِمَا أَحَقْ", "bab": 6}, {"n": 31, "sadr": "وَإِنْ يَكُونَا مَخْرَجاً تَقَارَبَا", "ajz": "وَفي الصِّفَاتِ اخْتَلَفَا يُلَقَّبَا", "bab": 6}, {"n": 32, "sadr": "مُتْقَارِبَيْنِ أَوْ يَكُونَا اتَّفَقَا", "ajz": "فِي مَخْرَجٍ دُونَ الصِّفَاتِ حُقِّقَا", "bab": 6}, {"n": 33, "sadr": "بِالْمُتَجَانِسَيْنِ ثُمَّ إِنْ سَكَنْ", "ajz": "أَوَّلُ كُلٍّ فَالصَّغِيرَ سَمِّيَنْ", "bab": 6}, {"n": 34, "sadr": "أَوْ حُرِّكَ الْحَرْفَانِ فى كُلٍّ فَقُلْ", "ajz": "كُلٌّ كَبِيرٌ وافْهَمَنْهُ بِالْمُثُلْ", "bab": 6}, {"n": 35, "sadr": "وَالمَدُّ أَصْلِىُّ وَ فَرْعِىٌّ لَهُ", "ajz": "وَسَمِّ أَوَّلاً طَبِيعِيّاً وَهُو", "bab": 7}, {"n": 36, "sadr": "مَالاَ تَوَقُّفٌ لَهُ عَلى سَبَبْ", "ajz": "وَلابِدُونِهِ الْحُروفُ تُجْتَلَبْ", "bab": 7}, {"n": 37, "sadr": "بلْ أَىُّ حَرْفٍ غَيْرِ هَمْزٍ أَوْ سُكُونْ", "ajz": "جَا بَعْدَ مَدٍّ فَالطَّبِيِعىَّ يَكُونْ", "bab": 7}, {"n": 38, "sadr": "وَالآخَرُ الْفَرْعِىُّ مَوْقُوفٌ عَلى", "ajz": "سَبَبْ كَهَمْزٍ أَوْ سُكُونٍ مُسْجَلاً", "bab": 7}, {"n": 39, "sadr": "حُرُوفُهُ ثَلاَثَةٌ فَعِيهَا", "ajz": "في لَفْظِ وَاىٍ وَهْىَ فى نُوحِيهَا", "bab": 7}, {"n": 40, "sadr": "وَالكَسْرُ قَبْلَ الْيَا وَقَبْلَ الْواوِ ضَمْ", "ajz": "شَرْطٌ وَفَتْحٌ قَبْلَ أَلْفٍ يُلْتَزَمْ", "bab": 7}, {"n": 41, "sadr": "وَاللِّينُ مِنْهَا الْيَا وَوَاوٌ سُكِنَا", "ajz": "إِنِ انْفِتَاحٌ قَبْلَ كُلٍّ أُعْلِنَا", "bab": 7}, {"n": 42, "sadr": "لِلْمَدِّ أَحْكَامٌ ثَلاَثَةٌ تَدُومْ", "ajz": "وَهْيَ الْوُجُوبُ وَالْجَوَازُ وَاللُّزُومْ", "bab": 8}, {"n": 43, "sadr": "فَوَاجِبٌ إِنْ جَاءَ هَمْزٌ بَعْدَ مَدْ", "ajz": "فِي كِلْمَةٍ وَذَا بِمُتَّصْلْ يُعَدْ", "bab": 8}, {"n": 44, "sadr": "وَجَائزٌ مَدٌ وَقَصْرٌ إِنْ فُصِل", "ajz": "كُلٌّ بِكِلْمَةٍ وَهَذَا المُنْفَصِلْ", "bab": 8}, {"n": 45, "sadr": "وَمِثْلُ ذَا إِنْ عَرَضَ السُّكُونُ", "ajz": "وَقْفَاً كَتَعْلَمُونَ نَسْتَعِينُ", "bab": 8}, {"n": 46, "sadr": "أَوْ قُدِّمَ الْهَمْزُ عَلَى المَدِّ وَذَا", "ajz": "بَدَلْ كَآمَنُوا وَإِيَماناً خُذَا", "bab": 8}, {"n": 47, "sadr": "وَلاَزِمٌ إِنِ السُّكُونُ أُصِّلاَ", "ajz": "وَصْلاَ وَوَقْفاً بَعْدَ مَدٍّ طُوّلاَ", "bab": 8}, {"n": 48, "sadr": "أَقْسَامُ لاَزِمٍ لَدَيْهِمْ أَرْبَعَةْ", "ajz": "وَتِلْكَ كِلْمِيٌّ وَحَرْفِيٌّ مَعَهْ", "bab": 9}, {"n": 49, "sadr": "كِلاَهُمَا مُخَفَّفٌ مُثَقَّلُ", "ajz": "فَهَذِهِ أَرْبَعَةٌ تُفَصَّلُ", "bab": 9}, {"n": 50, "sadr": "فَإِنْ بِكِلْمَةٍ سُكُونٌ اجْتَمَعْ", "ajz": "مَعْ حَرْفِ مَدٍّ فَهْوَ كِلْمِيٌّ وَقَعْ", "bab": 9}, {"n": 51, "sadr": "أَوْ في ثُلاَثِيِّ الْحُروفِ وُجِدَا", "ajz": "وَالْمَدُّ وَسْطُهُ فَحَرْفِيٌّ بَدَا", "bab": 9}, {"n": 52, "sadr": "كِلاَهُمَا مُثَقَّلٌ إِنْ أُدْغِمَا", "ajz": "مُخَفَفٌ كُلُّ إِذَا لَمْ يُدْغَمَا", "bab": 9}, {"n": 53, "sadr": "وَاللاَّزِمُ الْحَرْفِيُّ أَوَّلَ السُّوَرْ", "ajz": "وُجُودُهُ وَفِي ثَمَانٍ انحَصَرْ", "bab": 9}, {"n": 54, "sadr": "يَجْمَعُهَا حُرُوفُ كَمْ عَسَلْ نَقَصْ", "ajz": "وَعَيْنُ ذُو وَجْهَيْنِ والطُّولُ أَخَصْ", "bab": 9}, {"n": 55, "sadr": "وَمَا سِوَى الْحَرْفِ الثُّلاَثِي لاَ أَلِفْ", "ajz": "فَمَدُّهُ مَدٌّ طَبِيعِيٌّ أُلِفْ", "bab": 9}, {"n": 56, "sadr": "وَذَاكَ أَيْضاً فِي فَوَاتِحِ السُّوَرْ", "ajz": "فِي لَفْظِ حَيٌّ طَاهِرٌ قَدِ انْحَصَرْ", "bab": 9}, {"n": 57, "sadr": "وَيَجْمَعُ الْفَوَاتِحَ الأَرْبَعْ عَشَرْ", "ajz": "صِلْهُ سُحَيْراً مَنْ قَطَعْكَ ذَا اشْتَهَرْ", "bab": 9}, {"n": 58, "sadr": "وَتَمَّ ذَا النَّظْمُ بِحَمْدِ اللَّهِ", "ajz": "عَلَى تَمَامِهِ بِلاَ تَنَاهِى", "bab": 10}, {"n": 59, "sadr": "أَبْيَاتُهُ نَدٌّ بَداَ لِذِى النُّهَى", "ajz": "تَارِيخُها بُشْرَى لِمَنْ يُتْقِنُهَا", "bab": 10}, {"n": 60, "sadr": "ثُمَّ الصَّلاَةُ وَالسَّلاَمُ أَبَداَ", "ajz": "عِلى خِتَامِ الأَنْبِيَاءِ أَحْمَدَا", "bab": 10}, {"n": 61, "sadr": "وَالآلِ وَالصَّحْبِ وَكُلِّ تَابِعِ", "ajz": "وَكُلِّ قَارِئٍ وكُلِّ سَامِعِ", "bab": 10}]}