# Cloudflare Pages headers for أداة السرد القرآني.

# Hashed build output never changes under the same name.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The mushaf JSON and the Uthmani font are large and effectively frozen; the
# service worker revisions them, so a long cache is safe.
/hafs_smart_v8.json
  Cache-Control: public, max-age=31536000, immutable
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# The worker and the shell must never be served stale, or an update can never
# reach a device that already installed the app.
/sw.js
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
